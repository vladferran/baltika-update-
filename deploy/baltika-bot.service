[Unit]
Description=Baltika shift notifier bot
After=network-online.target postgresql.service redis-server.service
Wants=network-online.target

[Service]
Type=simple
User=botuser
WorkingDirectory=/opt/baltika_bot
EnvironmentFile=/opt/baltika_bot/.env
ExecStart=/opt/baltika_bot/.venv/bin/python -m app.bot
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
